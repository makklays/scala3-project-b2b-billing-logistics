
<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
        <!-- %X{traceId} автоматически выведет UUID ключа, если он есть в MDC context -->
        <pattern>%date [%level] из %logger в %thread [TRACE-ID: %X{traceId}] - %message%n</pattern>
    </encoder>
</appender>

